{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "summary": {
      "type": "string",
      "minLength": 60,
      "maxLength": 140
    },
    "subject": {
      "type": "string",
      "enum": [
        "physics",
        "chemistry",
        "mathematics",
        "biology"
      ]
    },
    "classLevel": {
      "type": "integer",
      "minimum": 6,
      "maximum": 12
    },
    "chapter": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        }
      },
      "required": [
        "number",
        "name"
      ],
      "additionalProperties": false
    },
    "ncertRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^Section \\d+(\\.\\d+)*(?![\\d.])",
      "description": "Where the concept is taught, starting with the section number, e.g. \"Section 1.4, Coulomb's Law\". Games are listed in this textbook order. Reference only; never copy text."
    },
    "order": {
      "description": "Position among games that share the same textbook section (lower comes first). Leave out if yours is the only one.",
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "concepts": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      }
    },
    "learningOutcome": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "What a student can do after winning that they could not reliably do before."
    },
    "mechanic": {
      "type": "string",
      "enum": [
        "tune-to-target",
        "build-the-setup",
        "predict-then-reveal",
        "fix-the-broken",
        "numeric-puzzle",
        "match-and-sort",
        "deduce-the-hidden",
        "other"
      ]
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "description": "Total for all levels."
    },
    "levels": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50
          },
          "tier": {
            "type": "string",
            "enum": [
              "concept",
              "application",
              "challenge"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "foundation",
              "complexity",
              "concept"
            ],
            "description": "foundation = the first level; complexity = same idea, harder numbers/steps/more bodies; concept = adds a new idea on top of the previous level."
          },
          "adds": {
            "type": "string",
            "minLength": 5,
            "maxLength": 160,
            "description": "Level 1: the baseline skill. Later levels: exactly what is new compared with the previous level."
          },
          "hints": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200
            },
            "description": "Ordered from gentlest nudge to most revealing. Each hint costs the student one star."
          }
        },
        "required": [
          "title",
          "tier",
          "kind",
          "adds",
          "hints"
        ],
        "additionalProperties": false
      },
      "description": "One level is fine for a single-difficulty game. With 2 or more, each level must add complexity or a concept."
    },
    "misconceptions": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 160
      }
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        }
      },
      "required": [
        "name",
        "github"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "title",
    "summary",
    "subject",
    "classLevel",
    "chapter",
    "ncertRef",
    "concepts",
    "learningOutcome",
    "mechanic",
    "estimatedMinutes",
    "levels",
    "author"
  ],
  "additionalProperties": false
}
